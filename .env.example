NODE_ENV=development
BACKEND_PORT=4001
FRONTEND_PORT=3001
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/bom_optimizer
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3001
# Optional advisory model; deterministic change workflows do not require it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
